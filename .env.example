# Copy to .env.local for local emulator development. No Firebase login is needed.
VITE_USE_FIREBASE_EMULATORS=true

# For your manually linked cloud project, set emulator mode to false and fill these in.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
