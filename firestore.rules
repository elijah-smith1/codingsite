rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    match /courses/javascript {
      allow read: if true;
      match /lessons/{lessonId} { allow read: if request.auth != null; }
    }
    match /users/{uid}/courses/javascript {
      allow read: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasAll(['lastLessonId', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['lastLessonId', 'updatedAt'])
        && request.resource.data.lastLessonId is string
        && exists(/databases/$(database)/documents/courses/javascript/lessons/$(request.resource.data.lastLessonId))
        && request.resource.data.updatedAt == request.time;
      match /lessons/{lessonId} {
        allow read: if owner(uid);
        allow create, update: if owner(uid)
          && exists(/databases/$(database)/documents/courses/javascript/lessons/$(lessonId))
          && request.resource.data.keys().hasAll(['completed', 'code', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['completed', 'code', 'updatedAt'])
          && request.resource.data.completed is bool
          && request.resource.data.code is string
          && request.resource.data.code.size() <= 50000
          && request.resource.data.updatedAt == request.time
          && (resource == null || resource.data.completed == false || request.resource.data.completed == true);
      }
    }
  }
}
